# Stripe secret key. Use sk_test_... while testing; checkout runs in demo mode when unset.
STRIPE_SECRET_KEY=

# Where the installers live. A buyer's file is served from
#   <DOWNLOAD_BASE_URL>/<version>/<file name>
# e.g. https://downloads.example.com/scorpion/0.1.7/Scorpion Setup 0.1.7.exe
DOWNLOAD_BASE_URL=

# Optional: the public site address, used for Stripe's return links.
# Defaults to the address the request came in on.
SITE_URL=

# With Cloudflare R2 (docs/cloudflare-downloads.md) this is the bucket's public address, e.g.
# https://downloads.example.com. The Scorpion OS image is served from <DOWNLOAD_BASE_URL>/os/.

# Signing in to My downloads (an emailed code):
# Any long random text. It signs the sign-in cookie; change it to sign everyone out.
SESSION_SECRET=
# Sends the code by email (resend.com); MAIL_FROM must be on a domain verified there.
RESEND_API_KEY=
MAIL_FROM=Scorpion <login@scorpionai.tech>
# The signing secret of the Stripe webhook (/api/stripe-webhook, events checkout.session.completed and
# checkout.session.async_payment_succeeded). It keeps each customer's list of orders complete.
STRIPE_WEBHOOK_SECRET=
