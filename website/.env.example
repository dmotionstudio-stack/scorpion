# Stripe secret key. Use sk_test_... while testing; checkout runs in demo mode when unset.
STRIPE_SECRET_KEY=

# Where the installers live. A buyer's file is served from
#   <DOWNLOAD_BASE_URL>/<version>/<file name>
# e.g. https://downloads.example.com/scorpion/0.1.7/Scorpion Setup 0.1.7.exe
DOWNLOAD_BASE_URL=

# Optional: the public site address, used for Stripe's return links.
# Defaults to the address the request came in on.
SITE_URL=
