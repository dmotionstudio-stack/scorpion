{
  "name": "kenzo",
  "productName": "Kenzo",
  "version": "0.1.0",
  "description": "Offline AI assistant and agent. Runs local GGUF models with llama.cpp - no API key, no internet.",
  "type": "module",
  "main": "src/main/main.js",
  "author": "Kenzo",
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "icon": "node scripts/make-icon.mjs",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "exceljs": "4.4.0",
    "mammoth": "1.13.0",
    "marked": "18.1.1",
    "node-llama-cpp": "3.22.2",
    "unpdf": "1.9.0"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.kenzo.desktop",
    "productName": "Kenzo",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/models",
        "to": "models",
        "filter": [
          "**/*.gguf"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/bins/**/*",
      "node_modules/node-llama-cpp/llama/**/*",
      "node_modules/@node-llama-cpp/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "resources/icon.png",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "resources/icon.png"
    }
  }
}
