{
  "name": "scorpion",
  "productName": "Scorpion",
  "version": "0.1.11",
  "description": "Offline AI assistant and agent. Runs local GGUF models with llama.cpp - no API key, no internet.",
  "type": "module",
  "main": "src/main/main.js",
  "author": "Scorpion",
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "icon": "node scripts/make-icon.mjs",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win dir && node scripts/make-portable.mjs",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@mediapipe/tasks-vision": "0.10.35",
    "@rapideditor/country-coder": "5.6.1",
    "dompurify": "3.4.17",
    "exceljs": "4.4.0",
    "exif-reader": "2.0.3",
    "kokoro-js": "1.2.1",
    "mammoth": "1.13.0",
    "marked": "18.1.1",
    "node-llama-cpp": "3.22.2",
    "three": "0.186.1",
    "unpdf": "1.9.0"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.scorpion.desktop",
    "productName": "Scorpion",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/@node-llama-cpp/win-x64-cuda/**",
      "!node_modules/@node-llama-cpp/win-x64-cuda-ext/**",
      "!node_modules/@node-llama-cpp/win-arm64/**",
      "!node_modules/node-llama-cpp/llama/gitRelease.bundle",
      "!node_modules/**/*.md",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/@huggingface/transformers/dist/ort-wasm*",
      "!node_modules/@huggingface/transformers/dist/transformers.js",
      "!node_modules/@huggingface/transformers/dist/transformers.min.js",
      "!node_modules/@huggingface/transformers/dist/transformers.web*.js",
      "!node_modules/kokoro-js/dist/kokoro.web.js",
      "!node_modules/three/src/**",
      "!node_modules/three/build/three.cjs",
      "!node_modules/three/build/three.webgpu*.js",
      "!node_modules/three/build/three.tsl.js",
      "!node_modules/three/examples/**",
      "!node_modules/@mediapipe/tasks-vision/vision_bundle.cjs",
      "!node_modules/@mediapipe/tasks-vision/wasm/vision_wasm_nosimd_internal.*",
      "!node_modules/@mediapipe/tasks-vision/wasm/vision_wasm_module_internal.*"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "extraResources": [
      {
        "from": "resources/models",
        "to": "models",
        "filter": [
          "**/*.gguf"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/bins/**/*",
      "node_modules/node-llama-cpp/llama/**/*",
      "node_modules/@node-llama-cpp/**/*",
      "node_modules/onnxruntime-node/bin/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**",
        "!node_modules/@node-llama-cpp/linux-*/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/linux/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "resources/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "resources/icon.png",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v3/win32/**",
        "!node_modules/@node-llama-cpp/linux-*/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/linux/**"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Scorpion listens to your voice so you can talk to it. Speech is processed on this Mac and never sent anywhere.",
        "NSCameraUsageDescription": "Scorpion watches your hands, only while Interact's gestures are on, so you can spin and zoom the orb. Video is processed on this Mac and never sent anywhere."
      }
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "executableName": "scorpion",
      "category": "Utility",
      "synopsis": "Offline AI assistant and desktop",
      "maintainer": "Scorpion <274588930+dmotionstudio-stack@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "Name": "Scorpion",
          "StartupWMClass": "scorpion"
        }
      },
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v3/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/linux/arm64/**",
        "!node_modules/@node-llama-cpp/win-*/**",
        "!node_modules/@node-llama-cpp/mac-*/**",
        "!node_modules/@node-llama-cpp/linux-arm*/**",
        "!node_modules/@node-llama-cpp/linux-x64-cuda*/**"
      ],
      "asar": false,
      "extraResources": [
        {
          "from": "resources/models",
          "to": "models",
          "filter": [
            "**/*.gguf"
          ]
        },
        {
          "from": "vendor/linux-node",
          "to": "node",
          "filter": [
            "node",
            "LICENSE"
          ]
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libvulkan1"
      ],
      "recommends": [
        "wlrctl",
        "pipewire",
        "wireplumber",
        "network-manager",
        "playerctl",
        "brightnessctl",
        "grim",
        "libnotify-bin"
      ]
    }
  }
}
