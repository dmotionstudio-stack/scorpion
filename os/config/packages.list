# Scorpion OS: the Ubuntu 24.04 packages in the system. One per line; "#"
# starts a comment. The build stops if one of these can't be installed.

# --- start-up, kernel and live system ---
ubuntu-minimal
systemd-sysv
linux-generic-hwe-24.04
initramfs-tools
casper
discover
laptop-detect
os-prober
grub-common
grub2-common
grub-pc-bin
grub-efi-amd64
grub-efi-amd64-signed
shim-signed
efibootmgr
mokutil
plymouth
plymouth-theme-spinner
sudo
locales
tzdata
keyboard-configuration
console-setup

# --- hardware: firmware, processors, graphics, drivers ---
linux-firmware
firmware-sof-signed
intel-microcode
amd64-microcode
ubuntu-drivers-common
software-properties-gtk
mesa-vulkan-drivers
libgl1-mesa-dri
mesa-va-drivers
intel-media-va-driver
fwupd
thermald
power-profiles-daemon
upower
udisks2
gvfs
gvfs-backends
ntfs-3g
exfatprogs
dosfstools
btrfs-progs

# --- network: Ethernet, Wi-Fi, mobile broadband, VPN ---
network-manager
systemd-resolved
network-manager-gnome
wpasupplicant
iw
wireless-regdb
modemmanager
network-manager-openvpn-gnome
ca-certificates
curl
openssh-client

# --- sound and Bluetooth ---
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
libspa-0.2-bluetooth
alsa-utils
alsa-ucm-conf
pavucontrol
playerctl
bluez
blueman

# --- printing ---
cups
ipp-usb
system-config-printer

# --- the Scorpion session: labwc, sign-in, helpers ---
labwc
xwayland
lightdm
lightdm-gtk-greeter
# the sign-in screen runs on X
xserver-xorg
mako-notifier
swaylock
swayidle
grim
slurp
wl-clipboard
wlrctl
wdisplays
brightnessctl
xdg-desktop-portal
xdg-desktop-portal-wlr
xdg-desktop-portal-gtk
policykit-1-gnome
libnotify-bin
dbus-user-session
gnome-keyring
xdg-utils
yaru-theme-gtk
yaru-theme-icon
adwaita-icon-theme
fonts-ubuntu
fonts-noto-core
fonts-noto-color-emoji

# --- apps (the intent wheel opens these) ---
foot
nautilus
gnome-text-editor
gnome-clocks
drawing
gnome-system-monitor
gnome-disk-utility
file-roller
eog
evince
mpv
update-manager
unattended-upgrades

# --- the native shell host (os/rootfs/usr/lib/scorpion-os/scorpion-shell):
# Scorpion's rail, wheel, notifications and on-screen display as Wayland
# layer-shell panels, in WebKitGTK ---
python3-gi
python3-gi-cairo
gir1.2-gtk-3.0
gir1.2-gtklayershell-0.1
gir1.2-webkit2-4.1

# --- apps from Flathub (Scorpion's agent installs apps with it) ---
flatpak

# --- the installer (removed from the installed system) ---
calamares
# its slideshow (show.qml) is QtQuick: without this, "Timer is not a type" and a blank page
qml-module-qtquick2
squashfs-tools
rsync
cryptsetup
# Qt apps (the installer is Qt 5) on Wayland
qtwayland5
qt6-wayland

# --- accessibility (the welcome and Settings → General): screen reader and on-screen keyboard ---
orca
wvkbd
