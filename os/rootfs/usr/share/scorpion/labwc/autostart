# Scorpion OS session: labwc runs this file with sh when the session starts.
# Session helpers first, then Scorpion as the desktop.

# Apps started through D-Bus and systemd (the session's own services below
# among them) see this session's display and settings.
dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP DESKTOP_SESSION \
  XKB_DEFAULT_LAYOUT XKB_DEFAULT_VARIANT XKB_DEFAULT_OPTIONS GTK_THEME XCURSOR_THEME XCURSOR_SIZE \
  MOZ_ENABLE_WAYLAND QT_QPA_PLATFORM SDL_VIDEODRIVER _JAVA_AWT_WM_NONREPARENTING XDG_DATA_DIRS >/dev/null 2>&1
[ -n "$WLR_RENDERER" ] && dbus-update-activation-environment --systemd WLR_RENDERER >/dev/null 2>&1

# Password prompts for system changes (Wi-Fi, installing, drivers).
for agent in /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 /usr/libexec/polkit-gnome-authentication-agent-1; do
  [ -x "$agent" ] && { "$agent" & break; }
done

# This session's logs (Scorpion and its shell), with the last session's kept
# beside them as *.old.log.
logs="${XDG_STATE_HOME:-$HOME/.local/state}/scorpion"
mkdir -p "$logs"
for name in scorpion shell idle; do
  [ -f "$logs/$name.log" ] && mv -f "$logs/$name.log" "$logs/$name.old.log"
done

# The rest are the session's services (/usr/lib/systemd/user/scorpion-*):
# Scorpion, its shell and the idle lock, each started again by systemd if it
# crashes. Only if they can't be started, the same by hand.
systemctl --user start scorpion-session.target && exit 0

# Scorpion's shell (the rail, the intent wheel, notifications, the
# on-screen display), started again if it crashes (up to three times). Where it
# can't run at all (exit 1: no layer-shell), mako shows notifications and
# Scorpion its own rail.
(
  for try in 1 2 3; do
    /usr/lib/scorpion-os/scorpion-shell
    code=$?
    [ "$code" -eq 0 ] && exit 0
    [ "$code" -eq 1 ] && break
    sleep 2
  done
  exec mako
) >>"$logs/shell.log" 2>&1 &

/usr/lib/scorpion-os/scorpion-idle >>"$logs/idle.log" 2>&1 &

# Scorpion: the desktop, taskbar (the edge rail) and launcher.
/usr/lib/scorpion-os/run-scorpion >>"$logs/scorpion.log" 2>&1 &
