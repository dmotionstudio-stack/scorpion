<?xml version="1.0" encoding="UTF-8"?>
<!-- Scorpion OS session: labwc's own menu (right-click the background when Scorpion isn't running). -->
<openbox_menu>
  <menu id="root-menu" label="">
    <item label="Start Scorpion"><action name="Execute" command="/usr/lib/scorpion-os/run-scorpion" /></item>
    <item label="Terminal"><action name="Execute" command="x-terminal-emulator" /></item>
    <item label="Files"><action name="Execute" command="nautilus" /></item>
    <item label="Web browser"><action name="Execute" command="xdg-open https://duckduckgo.com" /></item>
    <separator />
    <item label="Network"><action name="Execute" command="nm-connection-editor" /></item>
    <item label="Sound"><action name="Execute" command="pavucontrol" /></item>
    <item label="Displays"><action name="Execute" command="wdisplays" /></item>
    <item label="Additional drivers"><action name="Execute" command="software-properties-gtk --open-tab=4" /></item>
    <separator />
    <item label="Lock"><action name="Execute" command="swaylock -f" /></item>
    <item label="Sign out"><action name="Exit" /></item>
    <item label="Restart"><action name="Execute" command="systemctl reboot" /></item>
    <item label="Shut down"><action name="Execute" command="systemctl poweroff" /></item>
  </menu>
</openbox_menu>
