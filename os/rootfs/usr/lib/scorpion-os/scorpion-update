#!/bin/bash
# Scorpion OS: system updates for Scorpion (Settings → This computer, and its
# "Updates ready" notice), in place of Ubuntu's Software Updater pop-up.
#
#   scorpion-update check     refresh the package lists, then one line per
#                             update: name<TAB>installed<TAB>new
#   scorpion-update install   install them all (apt's hook takes a snapshot
#                             first, so it can be undone); progress lines
#                             start with "progress<TAB>" and a percentage
#   scorpion-update clock     put a wrong clock right (see below)
#   scorpion-update auto get|off|security|all
#                             what installs by itself (every day, in the
#                             background, snapshot first): nothing, security
#                             fixes only, or everything (security fixes,
#                             Ubuntu's updates and Scorpion's own versions)
#
# Administrators (the sudo group) may run it without a password
# (/etc/sudoers.d/scorpion-update). Apps from Flathub are updated by
# Scorpion as the user, not here.
#
# Exit codes: 0 done, 1 error, 3 usage, 4 the computer's clock is wrong (apt then says a repository's
# files are "not valid yet": the clock is behind). Scorpion answers with `clock` and tries again.
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8

# SCORPION_UPDATE_TEST lets the tests run it as a normal user against a folder of their own.
CONF_DIR="${SCORPION_APT_CONF_DIR:-/etc/apt/apt.conf.d}"
if [ -z "${SCORPION_UPDATE_TEST:-}" ]; then
  [ "$(id -u)" -eq 0 ] || { echo "scorpion-update: run it with sudo" >&2; exit 1; }
fi

# Another program (unattended-upgrades, Software Updater) may hold apt's lock:
# wait for it up to 10 minutes instead of failing.
APT=(apt-get -o DPkg::Lock::Timeout=600 -q)

check() {
  local err
  err="$(mktemp)"
  if ! "${APT[@]}" update >/dev/null 2>"$err"; then
    if grep -qiE 'not valid yet|invalid for another' "$err"; then rm -f "$err"; echo "scorpion-update: the clock is wrong" >&2; exit 4; fi
    cat "$err" >&2; rm -f "$err"; exit 1
  fi
  rm -f "$err"
  # "Inst name [installed] (new suite [arch])" for each upgrade.
  "${APT[@]}" -s full-upgrade | sed -n 's/^Inst \([^ ]*\) \[\([^]]*\)\] (\([^ ]*\) .*/\1\t\2\t\3/p'
}

install() {
  local total done=0
  total="$("${APT[@]}" -s full-upgrade | grep -c '^Inst ' || true)"
  echo -e "progress\t0\tStarting"
  # Each package unpacked and set up is two steps.
  "${APT[@]}" -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold full-upgrade 2>&1 |
    while IFS= read -r line; do
      case "$line" in
        Unpacking*|Setting\ up*)
          done=$((done + 1))
          [ "$total" -gt 0 ] && echo -e "progress\t$(( done * 50 / total ))\t${line%% (*}" ;;
      esac
    done
  [ "${PIPESTATUS[0]}" -eq 0 ] || { echo "scorpion-update: apt-get failed" >&2; exit 1; }
  "${APT[@]}" -y autoremove --purge >/dev/null 2>&1 || true
  echo -e "progress\t100\tDone"
}

# Automatic installs are Ubuntu's unattended-upgrades; this file (read after its own 50unattended-upgrades) says which origins it may take from.
AUTO_FILE="$CONF_DIR/52scorpion-auto-upgrades"
auto() {
  local level="${1:-get}"
  case "$level" in
    get)
      # No file: Ubuntu's own default, security fixes only.
      { grep -m1 '^// level: ' "$AUTO_FILE" 2>/dev/null | cut -d' ' -f3; } | grep -E '^(off|security|all)$' || echo security
      return 0 ;;
    off|security|all) ;;
    *) echo "usage: scorpion-update auto get|off|security|all" >&2; exit 3 ;;
  esac
  local tmp
  tmp="$(mktemp "$CONF_DIR/.52scorpion.XXXXXX")"
  {
    echo "// level: $level"
    echo "// Written by scorpion-update auto (Settings → This computer): what installs by itself."
    if [ "$level" = off ]; then
      echo 'APT::Periodic::Update-Package-Lists "0";'
      echo 'APT::Periodic::Unattended-Upgrade "0";'
    else
      echo 'APT::Periodic::Update-Package-Lists "1";'
      echo 'APT::Periodic::Unattended-Upgrade "1";'
      echo '#clear Unattended-Upgrade::Allowed-Origins;'
      echo 'Unattended-Upgrade::Allowed-Origins {'
      echo '  "${distro_id}:${distro_codename}-security";'
      if [ "$level" = all ]; then
        echo '  "${distro_id}:${distro_codename}";'
        echo '  "${distro_id}:${distro_codename}-updates";'
        echo '  "Scorpion:stable";'
      fi
      echo '};'
      # Never restart by itself: Scorpion says "Restart to finish" when the system asks for it.
      echo 'Unattended-Upgrade::Automatic-Reboot "false";'
      echo 'Unattended-Upgrade::Remove-Unused-Dependencies "true";'
      echo 'Unattended-Upgrade::MinimalSteps "true";'
    fi
  } > "$tmp"
  chmod 644 "$tmp"
  mv -f "$tmp" "$AUTO_FILE"
  echo "$level"
}

# Another operating system (Windows) on this computer keeps the hardware clock in local time; Linux assumes UTC, and the
# clock is then hours off. Windows is looked for in the boot partition (SCORPION_EFI_DIR in the tests) and by os-prober.
windows_here() {
  [ -d "${SCORPION_EFI_DIR:-/boot/efi}/EFI/Microsoft" ] && return 0
  command -v os-prober >/dev/null 2>&1 && os-prober 2>/dev/null | grep -qi windows
}

# Puts a wrong clock right: the internet's time first (so the system clock is true), then, beside Windows, the hardware clock in
# local time, which Windows expects, so that neither system moves the other one's clock. Prints "synced" or "not synced".
fixclock() {
  timedatectl set-ntp true 2>/dev/null || true
  systemctl restart systemd-timesyncd.service 2>/dev/null || true
  local i state=no
  for i in $(seq "${SCORPION_CLOCK_WAIT:-30}"); do
    state="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || echo no)"
    [ "$state" = yes ] && break
    sleep 1
  done
  if windows_here; then
    timedatectl set-local-rtc 1 2>/dev/null || true
    hwclock --systohc 2>/dev/null || true
  fi
  if [ "$state" = yes ]; then echo synced; else echo "not synced"; fi
}

case "${1:-}" in
  clock) fixclock ;;
  check) check ;;
  install) install ;;
  auto) auto "${2:-get}" ;;
  *) echo "usage: scorpion-update check | install | clock | auto get|off|security|all" >&2; exit 3 ;;
esac
