#!/bin/sh
# Scorpion OS's idle handling (scorpion-idle.service): lock after 10 idle
# minutes and before sleep; screens off after 15. Waking from standby, each
# screen is switched off and on again, which makes the graphics set it up
# afresh (some wake black, or stay off, otherwise), and the lock is made sure
# of.
exec swayidle -w \
  timeout 600 '/usr/lib/scorpion-os/scorpion-lock' \
  timeout 900 'wlopm --off \*' resume 'wlopm --on \*' \
  before-sleep '/usr/lib/scorpion-os/scorpion-lock' \
  after-resume 'wlopm --off \*; sleep 1; wlopm --on \*; /usr/lib/scorpion-os/scorpion-lock' \
  lock '/usr/lib/scorpion-os/scorpion-lock'
