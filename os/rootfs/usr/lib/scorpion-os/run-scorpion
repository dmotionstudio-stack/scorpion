#!/bin/sh
# Starts Scorpion as the desktop of the Scorpion session, and starts it again
# if it crashes (up to three times in two minutes; then the session stays up
# with labwc's own menu: right-click the background, or Super+Return for a
# terminal). Quitting Scorpion on purpose (exit code 0) ends the session.
crashes=0
first=$(date +%s)
while :; do
  /usr/bin/scorpion --shell --ozone-platform=x11 "$@"
  code=$?
  [ "$code" -eq 0 ] && exec labwc --exit
  now=$(date +%s)
  if [ $((now - first)) -gt 120 ]; then crashes=0; first=$now; fi
  crashes=$((crashes + 1))
  if [ "$crashes" -ge 3 ]; then
    notify-send -u critical "Scorpion stopped" "Scorpion closed unexpectedly three times. Right-click the background for a menu, or press Super+Return for a terminal. What happened is in ~/.local/state/scorpion/scorpion.log." 2>/dev/null
    exit 1
  fi
  sleep 2
done
