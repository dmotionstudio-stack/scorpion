#!/usr/bin/python3
"""Scorpion OS's shell host.

Shows Scorpion's always-on surfaces as Wayland layer-shell panels (the
proper place for panels: the compositor places them, keeps them on top, and
keeps the rail's strip free for other windows), each one of Scorpion's own
pages in WebKitGTK:

  edge.html    the rail down the right edge (reserves its 76 pixels, or
               hides until the pointer touches the edge)
  summon.html  the summon dot (bottom left, or wherever it was dragged),
               opening into the intent wheel
  stage.html   Stage: the open apps' strip that slides in from the left edge
  notify.html  notification cards and the list, beside the rail
  quick.html   quick settings (Wi-Fi, Bluetooth, sound, brightness, battery)
  osd.html     the on-screen volume and brightness

The pages talk to Scorpion over its local shell API (src/main/shell-api.js;
the address and key are in $XDG_RUNTIME_DIR/scorpion-shell.json), and to this
host through WebKit's "scorpionShell" message handler (placing panels,
native menus, notification actions).

It is also the session's notification server (org.freedesktop.Notifications):
notifications go to Scorpion, which keeps them and shows them here.
"""
import base64
import json
import os
import sys
import threading
import time
import urllib.request

# WebKitGTK's GPU paths draw nothing where the graphics driver can't do them
# (virtual machines, some drivers); the panels are small and simple, so they
# are painted in software unless the session says otherwise.
os.environ.setdefault("WEBKIT_DISABLE_DMABUF_RENDERER", "1")
os.environ.setdefault("WEBKIT_DISABLE_COMPOSITING_MODE", "1")

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gdk, Gio, GLib, Gtk, GtkLayerShell, WebKit2  # noqa: E402

try:
    import cairo  # input regions: a panel that lets clicks through
except ImportError:
    cairo = None

RAIL = 76
DOT = 88
STAGE = 230
EDGE = 3  # the strip at a screen edge that brings a hidden panel back
NOTIFY_WIDTH = 380
QUICK_WIDTH = 360
# The panels that open beside the rail, and their widths.
BESIDE_RAIL = {"notify": NOTIFY_WIDTH, "quick": QUICK_WIDTH}
INFO = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "scorpion-shell.json")
E = GtkLayerShell.Edge


def log(*args):
    print("scorpion-shell:", *args, file=sys.stderr, flush=True)


class Api:
    """Scorpion's local shell API."""

    def __init__(self):
        self.base = None

    def load(self):
        try:
            with open(INFO) as f:
                info = json.load(f)
            os.kill(int(info["pid"]), 0)  # Scorpion is running
            self.base = f"http://127.0.0.1:{info['port']}/{info['key']}"
            return True
        except Exception:
            self.base = None
            return False

    def page(self, name):
        return f"{self.base}/{name}"

    def call(self, channel, arg=None, on_fail=None):
        """A call in the background (never blocks the panels). on_fail runs
        on the main loop when Scorpion can't be reached."""
        if not self.base and not self.load():
            if on_fail:
                GLib.idle_add(on_fail)
            return
        url = f"{self.base}/ipc/{channel}"
        body = json.dumps(arg).encode()

        def go():
            try:
                req = urllib.request.Request(url, data=body, headers={"Content-Type": "application/json"}, method="POST")
                urllib.request.urlopen(req, timeout=15).read()
            except Exception as err:  # Scorpion restarting, or not running
                log(channel, err)
                if on_fail:
                    GLib.idle_add(on_fail)

        threading.Thread(target=go, daemon=True).start()


api = Api()


class Panel(Gtk.Window):
    """One layer-shell panel showing one of Scorpion's pages."""

    def __init__(self, host, page, *, layer, anchors, width, height, exclusive=0, margins=None, keyboard="none"):
        super().__init__(title=f"Scorpion {page}")
        self.host = host
        self.page = page
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.set_app_paintable(True)
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, f"scorpion-{page.split('.')[0]}")
        self.place(layer=layer, anchors=anchors, width=width, height=height, exclusive=exclusive, margins=margins or {}, keyboard=keyboard)

        manager = WebKit2.UserContentManager()
        manager.register_script_message_handler("scorpionShell")
        manager.connect("script-message-received::scorpionShell", self.on_message)
        self.view = WebKit2.WebView.new_with_user_content_manager(manager)
        self.view.set_background_color(Gdk.RGBA(0, 0, 0, 0))
        settings = self.view.get_settings()
        settings.set_enable_developer_extras(False)
        settings.set_enable_write_console_messages_to_stdout(True)
        self.view.connect("context-menu", lambda *a: True)  # the pages have their own
        self.add(self.view)
        self.load()

    def place(self, *, layer, anchors, width, height, exclusive=0, margins=None, keyboard="none"):
        GtkLayerShell.set_layer(self, layer)
        for edge in (E.LEFT, E.RIGHT, E.TOP, E.BOTTOM):
            GtkLayerShell.set_anchor(self, edge, edge in anchors)
        for edge in (E.LEFT, E.RIGHT, E.TOP, E.BOTTOM):
            GtkLayerShell.set_margin(self, edge, (margins or {}).get(edge, 0))
        GtkLayerShell.set_exclusive_zone(self, exclusive)
        mode = {"none": GtkLayerShell.KeyboardMode.NONE, "exclusive": GtkLayerShell.KeyboardMode.EXCLUSIVE, "on-demand": GtkLayerShell.KeyboardMode.ON_DEMAND}[keyboard]
        GtkLayerShell.set_keyboard_mode(self, mode)
        self.set_size_request(width, height)
        self.resize(max(1, width), max(1, height))

    def load(self):
        self.view.load_uri(api.page(self.page))

    def clicks(self, rect=None):
        """Where the panel takes clicks: everywhere (None), only in
        (x, y, width, height), or nowhere (an empty one), when it can say."""
        win = self.get_window()
        if not win or cairo is None:
            return
        # (GDK takes no "none" here from Python: everywhere is a region as
        # big as any screen.)
        x, y, w, h = rect if rect is not None else (0, 0, 1 << 15, 1 << 15)
        region = cairo.Region(cairo.RectangleInt(x, y, w, h)) if w > 0 and h > 0 else cairo.Region()
        win.input_shape_combine_region(region, 0, 0)

    def js(self, code):
        self.view.evaluate_javascript(code, -1, None, None, None, None, None)

    def on_message(self, _manager, result):
        try:
            msg = json.loads(result.get_js_value().to_string())
        except Exception:
            return
        if os.environ.get("SCORPION_SHELL_DEBUG") or msg.get("type") == "stage":
            log("from", self.page, msg.get("type"))
        self.host.handle(self, msg)


class Notice(Gtk.Window):
    """A notification shown by the host itself, for when Scorpion can't show
    it (for example "Scorpion stopped"): top right, beside the rail. Click to
    close; it closes itself after 8 seconds unless it is urgent."""

    CSS = b"""
    .scorpion-notice { background: #161512; border: 1px solid #f5c518; border-radius: 12px; padding: 12px 14px; }
    .scorpion-notice .title { color: #f5c518; font-weight: bold; }
    .scorpion-notice .body { color: #f2eee2; }
    """
    shown = []

    def __init__(self, summary, body, urgency=1):
        super().__init__(title="Scorpion notice")
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "scorpion-notice")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_anchor(self, E.TOP, True)
        GtkLayerShell.set_anchor(self, E.RIGHT, True)
        GtkLayerShell.set_margin(self, E.TOP, 8 + 96 * len(Notice.shown))
        GtkLayerShell.set_margin(self, E.RIGHT, RAIL + 8)
        css = Gtk.CssProvider()
        css.load_from_data(self.CSS)
        Gtk.StyleContext.add_provider_for_screen(self.get_screen(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.get_style_context().add_class("scorpion-notice")
        box.set_size_request(NOTIFY_WIDTH, -1)
        for text, cls in ((summary, "title"), (body, "body")):
            if text:
                label = Gtk.Label(label=text, xalign=0)
                label.set_line_wrap(True)
                label.set_max_width_chars(48)
                label.get_style_context().add_class(cls)
                box.pack_start(label, False, False, 0)
        events = Gtk.EventBox()
        events.add(box)
        events.connect("button-press-event", lambda *a: self.close_notice())
        self.add(events)
        self.show_all()
        Notice.shown.append(self)
        if urgency < 2:
            GLib.timeout_add_seconds(8, self.close_notice)

    def close_notice(self):
        if self in Notice.shown:
            Notice.shown.remove(self)
            self.destroy()
        return False


class Notifications:
    """The session's notification server: org.freedesktop.Notifications."""

    XML = """
    <node>
      <interface name="org.freedesktop.Notifications">
        <method name="GetCapabilities"><arg direction="out" type="as"/></method>
        <method name="Notify">
          <arg direction="in" type="s" name="app_name"/><arg direction="in" type="u" name="replaces_id"/>
          <arg direction="in" type="s" name="app_icon"/><arg direction="in" type="s" name="summary"/>
          <arg direction="in" type="s" name="body"/><arg direction="in" type="as" name="actions"/>
          <arg direction="in" type="a{sv}" name="hints"/><arg direction="in" type="i" name="expire_timeout"/>
          <arg direction="out" type="u"/>
        </method>
        <method name="CloseNotification"><arg direction="in" type="u" name="id"/></method>
        <method name="GetServerInformation">
          <arg direction="out" type="s"/><arg direction="out" type="s"/><arg direction="out" type="s"/><arg direction="out" type="s"/>
        </method>
        <signal name="NotificationClosed"><arg type="u"/><arg type="u"/></signal>
        <signal name="ActionInvoked"><arg type="u"/><arg type="s"/></signal>
      </interface>
    </node>"""

    def __init__(self):
        self.conn = None
        self.next_id = 1
        self.open = set()
        info = Gio.DBusNodeInfo.new_for_xml(self.XML)
        self.iface = info.interfaces[0]
        Gio.bus_own_name(Gio.BusType.SESSION, "org.freedesktop.Notifications", Gio.BusNameOwnerFlags.REPLACE | Gio.BusNameOwnerFlags.ALLOW_REPLACEMENT,
                         self.on_bus, None, lambda *a: log("another notification server owns the name"))

    def on_bus(self, conn, _name):
        self.conn = conn
        conn.register_object("/org/freedesktop/Notifications", self.iface, self.on_call, None, None)

    def icon(self, app_icon, hints):
        """The notification's icon as a data URL (the pages can't read files)."""
        path = None
        name = (hints.get("image-path") or hints.get("image_path") or app_icon or "").replace("file://", "")
        if name.startswith("/") and os.path.isfile(name):
            path = name
        elif name:
            info = Gtk.IconTheme.get_default().lookup_icon(name, 48, 0)
            path = info.get_filename() if info else None
        if not path:
            return None
        try:
            with open(path, "rb") as f:
                data = f.read(512 * 1024)
            kind = "image/svg+xml" if path.endswith(".svg") else "image/png"
            return f"data:{kind};base64,{base64.b64encode(data).decode()}"
        except OSError:
            return None

    def on_call(self, _conn, _sender, _path, _iface, method, params, invocation):
        if method == "GetCapabilities":
            invocation.return_value(GLib.Variant("(as)", (["body", "actions", "icon-static", "persistence"],)))
        elif method == "GetServerInformation":
            invocation.return_value(GLib.Variant("(ssss)", ("Scorpion", "Scorpion OS", "0.1", "1.2")))
        elif method == "Notify":
            app, replaces, app_icon, summary, body, actions, hints, _timeout = params.unpack()
            nid = replaces or self.next_id
            if not replaces:
                self.next_id += 1
            self.open.add(nid)
            urgency = int(hints.get("urgency", 1))
            # Scorpion keeps and shows notifications; when it can't (not
            # running, or stopped), this host shows the notice itself.
            api.call("shell:notifyIn", {"id": nid, "app": app, "summary": summary, "body": body, "icon": self.icon(app_icon, hints), "urgency": urgency, "actions": list(actions)},
                     on_fail=lambda: self.show_here(summary, body, urgency))
            invocation.return_value(GLib.Variant("(u)", (nid,)))
        elif method == "CloseNotification":
            (nid,) = params.unpack()
            self.closed(nid, 3)
            invocation.return_value(None)

    @staticmethod
    def show_here(summary, body, urgency):
        Notice(summary, body, urgency)
        return False  # once (GLib.idle_add)

    def closed(self, nid, reason):
        """reason: 1 expired, 2 dismissed, 3 closed by the app."""
        if nid in self.open:
            self.open.discard(nid)
            api.call("shell:notifyClosed", {"id": nid})
        if self.conn:
            self.conn.emit_signal(None, "/org/freedesktop/Notifications", "org.freedesktop.Notifications", "NotificationClosed", GLib.Variant("(uu)", (nid, reason)))

    def action(self, nid, key):
        if self.conn:
            self.conn.emit_signal(None, "/org/freedesktop/Notifications", "org.freedesktop.Notifications", "ActionInvoked", GLib.Variant("(us)", (nid, key)))
        self.closed(nid, 2)


class EdgeStrip(Gtk.Window):
    """An invisible strip along a screen edge: the pointer touching it calls
    on_enter (Stage's strip, a hidden rail)."""

    def __init__(self, edge, on_enter):
        super().__init__(title="Scorpion edge")
        visual = self.get_screen().get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.set_app_paintable(True)
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "scorpion-edge-strip")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        for e in (E.TOP, E.BOTTOM, edge):
            GtkLayerShell.set_anchor(self, e, True)
        GtkLayerShell.set_exclusive_zone(self, -1)
        self.set_size_request(EDGE, -1)
        self.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK)
        self.connect("enter-notify-event", lambda *_: on_enter())
        self.connect("draw", lambda _w, cr: True)  # draws nothing


class Host:
    def __init__(self):
        self.panels = {}
        self.notifications = Notifications()
        self.ready = False
        self.dot = (8, 8)  # the summon dot's left and bottom margins
        self.wheel_open = False
        # The rail hiding by itself, and whether it's hidden now.
        self.rail_hides = False
        self.rail_hidden = False
        self.rail_timer = 0
        self.rail_held = False  # a menu from it is open
        # Stage: on, shown, a window flying in, and its edge strip.
        self.stage_on = False
        self.stage_shown = False
        self.stage_timer = 0
        self.stage_strip = None

    def start(self):
        """Once Scorpion's shell API is up: the panels."""
        if not api.load():
            GLib.timeout_add(500, self.start)
            return False
        # All on the overlay layer: Scorpion's full mode is a full-screen
        # window, which compositors draw above the top layer.
        overlay = GtkLayerShell.Layer.OVERLAY
        self.panels["edge"] = Panel(self, "edge.html", layer=overlay, anchors={E.RIGHT, E.TOP, E.BOTTOM}, width=RAIL, height=-1, exclusive=RAIL)
        self.panels["summon"] = Panel(self, "summon.html", layer=overlay, anchors={E.LEFT, E.BOTTOM}, width=DOT, height=DOT, margins={E.LEFT: 8, E.BOTTOM: 8})
        self.panels["notify"] = Panel(self, "notify.html", layer=overlay, anchors={E.TOP, E.RIGHT}, width=NOTIFY_WIDTH, height=1, margins={E.TOP: 8, E.RIGHT: RAIL + 8})
        self.panels["quick"] = Panel(self, "quick.html", layer=overlay, anchors={E.TOP, E.RIGHT}, width=QUICK_WIDTH, height=1, margins={E.TOP: 8, E.RIGHT: RAIL + 8})
        self.panels["osd"] = Panel(self, "osd.html", layer=overlay, anchors={E.BOTTOM}, width=340, height=90, margins={E.BOTTOM: 90})
        self.panels["stage"] = Panel(self, "stage.html", layer=overlay, anchors={E.LEFT, E.TOP, E.BOTTOM}, width=STAGE, height=-1, exclusive=-1)
        self.panels["edge"].show_all()
        self.panels["summon"].show_all()
        for name in ("notify", "quick", "osd", "stage"):
            self.panels[name].show_all()
            self.panels[name].hide()
        # The pointer on the rail (it stays) or leaving it (a hiding rail goes).
        edge = self.panels["edge"]
        edge.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        edge.connect("enter-notify-event", lambda *_: self.rail_show())
        edge.connect("leave-notify-event", self.on_rail_leave)
        stage = self.panels["stage"]
        stage.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        stage.connect("enter-notify-event", lambda *_: self.stage_keep())
        stage.connect("leave-notify-event", self.on_stage_leave)
        self.say_ready()
        self.listen()
        self.ready = True
        # Scorpion restarted: a new address and key, so the pages load again.
        monitor = Gio.File.new_for_path(INFO).monitor_file(Gio.FileMonitorFlags.NONE, None)
        monitor.connect("changed", self.on_info_changed)
        self.monitor = monitor
        return False

    def on_info_changed(self, *_):
        old = api.base
        if api.load() and api.base != old:
            log("Scorpion restarted; reloading the panels")
            for p in self.panels.values():
                p.load()
            self.say_ready()

    def listen(self):
        """Scorpion's shell events, passed to every panel (shell-bridge.js's
        window.scorpionEvent): one connection held here. WebKit lets the
        panels' site have six connections at once, so a connection held open
        by each panel left none for their calls once there were six panels."""
        def run():
            while True:
                if not api.base and not api.load():
                    time.sleep(2)
                    continue
                try:
                    with urllib.request.urlopen(f"{api.base}/events") as res:
                        event, data = None, []
                        for raw in res:
                            line = raw.decode("utf-8").rstrip("\r\n")
                            if line.startswith("event: "):
                                event = line[7:]
                            elif line.startswith("data: "):
                                data.append(line[6:])
                            elif not line:
                                if event and data:
                                    GLib.idle_add(self.dispatch, event, "\n".join(data))
                                event, data = None, []
                except Exception as err:  # Scorpion restarting, or gone
                    log("events", err)
                api.base = None  # look for Scorpion's address again
                time.sleep(2)

        threading.Thread(target=run, daemon=True).start()

    def dispatch(self, event, data):
        if event.startswith("stage:"):
            log("event", event)
        code = f"window.scorpionEvent && window.scorpionEvent({json.dumps(event)}, {data})"
        for p in self.panels.values():
            p.js(code)
        return False

    def say_ready(self, tries=0):
        """Tells Scorpion its panels are here (it then hides its own); again
        a little later if Scorpion isn't answering yet."""
        def again():
            if tries < 30:
                GLib.timeout_add_seconds(2, lambda: self.say_ready(tries + 1))
            return False
        api.call("shell:hostReady", on_fail=again)
        return False

    def wheel(self, is_open):
        p = self.panels["summon"]
        self.wheel_open = is_open
        if is_open:
            self.stage_hide(now=True)
            p.place(layer=GtkLayerShell.Layer.OVERLAY, anchors={E.LEFT, E.RIGHT, E.TOP, E.BOTTOM}, width=-1, height=-1, exclusive=-1, keyboard="exclusive")
            p.present()
        else:
            self.place_dot()

    def place_dot(self):
        """The dot where it was dropped (its page says, from Scorpion's settings)."""
        left, bottom = self.dot
        self.panels["summon"].place(layer=GtkLayerShell.Layer.OVERLAY, anchors={E.LEFT, E.BOTTOM}, width=DOT, height=DOT, margins={E.LEFT: left, E.BOTTOM: bottom}, keyboard="none")

    # ---------- the rail hiding by itself ----------
    def rail_mode(self, hides):
        """Auto-hide on: the rail keeps no room and slides away until the
        pointer touches the right edge (only its last few pixels take the
        pointer meanwhile). Off: it keeps its room, always there."""
        if hides == self.rail_hides:
            return
        self.rail_hides = hides
        GtkLayerShell.set_exclusive_zone(self.panels["edge"], 0 if hides else RAIL)
        if hides:
            self.rail_hide()
        else:
            self.rail_show()

    def rail_show(self):
        if self.rail_timer:
            GLib.source_remove(self.rail_timer)
            self.rail_timer = 0
        if not self.rail_hidden:
            return
        self.rail_hidden = False
        edge = self.panels["edge"]
        edge.clicks(None)
        edge.js("window.scorpionRail && window.scorpionRail(false)")

    def rail_hide(self):
        self.rail_timer = 0
        if not self.rail_hides or self.rail_held:
            return False
        self.rail_hidden = True
        edge = self.panels["edge"]
        edge.js("window.scorpionRail && window.scorpionRail(true)")
        # Without input regions it can't let clicks through: then it stays.
        if cairo is None:
            self.rail_hidden = False
            edge.js("window.scorpionRail && window.scorpionRail(false)")
            return False
        edge.clicks((RAIL - EDGE, 0, EDGE, self.get_screen_height()))
        return False

    def on_rail_leave(self, _w, event):
        if event.detail == Gdk.NotifyType.INFERIOR or not self.rail_hides or self.rail_hidden:
            return
        if not self.rail_timer:
            self.rail_timer = GLib.timeout_add(600, self.rail_hide)

    # ---------- Stage ----------
    def stage_mode(self, on):
        """Stage on: an invisible strip along the left edge slides it in."""
        self.stage_on = on
        log("stage", "on" if on else "off")
        if on and not self.stage_strip:
            self.stage_strip = EdgeStrip(E.LEFT, self.stage_show)
            self.stage_strip.show_all()
        elif not on and self.stage_strip:
            self.stage_strip.destroy()
            self.stage_strip = None
            self.stage_hide(now=True)

    def stage_show(self):
        log("stage: the pointer at the left edge", self.stage_on, self.stage_shown, self.wheel_open)
        if not self.stage_on or self.stage_shown or self.wheel_open:
            return
        self.stage_shown = True
        p = self.panels["stage"]
        p.place(layer=GtkLayerShell.Layer.OVERLAY, anchors={E.LEFT, E.TOP, E.BOTTOM}, width=STAGE, height=-1, exclusive=-1)
        p.show_all()
        p.clicks(None)
        p.js("window.scorpionStage && window.scorpionStage.show()")

    def stage_keep(self):
        if self.stage_timer:
            GLib.source_remove(self.stage_timer)
            self.stage_timer = 0

    def on_stage_leave(self, _w, event):
        if event.detail == Gdk.NotifyType.INFERIOR or not self.stage_shown:
            return
        self.stage_keep()
        self.stage_timer = GLib.timeout_add(400, self.stage_hide)

    def stage_hide(self, now=False):
        self.stage_timer = 0
        if not self.stage_shown:
            return False
        self.stage_shown = False
        p = self.panels["stage"]
        p.js("window.scorpionStage && window.scorpionStage.hide()")

        def gone():
            if not self.stage_shown:
                p.hide()
            return False
        GLib.timeout_add(0 if now else 220, gone)
        return False

    def stage_arriving(self):
        """A window just minimized flies in: for the flight the panel covers
        the screen and lets every click through."""
        log("stage: a window flies in", self.stage_on, self.wheel_open)
        if not self.stage_on or self.wheel_open:
            return
        self.stage_keep()
        self.stage_shown = True
        p = self.panels["stage"]
        p.place(layer=GtkLayerShell.Layer.OVERLAY, anchors={E.LEFT, E.RIGHT, E.TOP, E.BOTTOM}, width=-1, height=-1, exclusive=-1)
        p.show_all()
        p.clicks((0, 0, 0, 0))

    def stage_arrived(self):
        """Landed: back to a strip, which stays a moment, then slides away
        unless the pointer is on it."""
        if not self.stage_shown:
            return
        p = self.panels["stage"]
        p.place(layer=GtkLayerShell.Layer.OVERLAY, anchors={E.LEFT, E.TOP, E.BOTTOM}, width=STAGE, height=-1, exclusive=-1)
        p.clicks(None)
        self.stage_keep()
        self.stage_timer = GLib.timeout_add(1400, self.stage_hide)

    def menu(self, panel, msg):
        """A native menu at the pointer, from Scorpion's description."""
        token = msg.get("token")

        def build(items):
            menu = Gtk.Menu()
            group = None
            for it in items:
                if it.get("type") == "separator":
                    menu.append(Gtk.SeparatorMenuItem())
                    continue
                kind = it.get("type", "normal")
                if kind in ("checkbox", "radio"):
                    item = Gtk.CheckMenuItem(label=it.get("label", ""))
                    item.set_draw_as_radio(kind == "radio")
                    item.set_active(bool(it.get("checked")))
                else:
                    item = Gtk.MenuItem(label=it.get("label", ""))
                item.set_sensitive(bool(it.get("enabled", True)))
                if it.get("submenu"):
                    item.set_submenu(build(it["submenu"]))
                elif it.get("id"):
                    item.connect("activate", lambda _w, iid=it["id"]: api.call("shell:menuPick", {"token": token, "id": iid}))
                menu.append(item)
            menu.show_all()
            return menu

        m = build(msg.get("items") or [])
        panel.menu = m  # kept alive while open
        # A hiding rail stays while its menu is up.
        if panel.page == "edge.html":
            self.rail_held = True

            def released(*_):
                self.rail_held = False
                if self.rail_hides and not self.rail_timer:
                    self.rail_timer = GLib.timeout_add(800, self.rail_hide)
            m.connect("deactivate", released)
        x, y = int(msg.get("x", 0)), int(msg.get("y", 0))
        rect = Gdk.Rectangle()
        rect.x, rect.y, rect.width, rect.height = x, y, 1, 1
        # From the rail, menus open to the left of the pointer.
        anchor = Gdk.Gravity.NORTH_EAST if panel.page == "edge.html" else Gdk.Gravity.NORTH_WEST
        m.popup_at_rect(panel.get_window(), rect, Gdk.Gravity.NORTH_WEST, anchor, None)

    def handle(self, panel, msg):
        kind = msg.get("type")
        if kind == "wheel":
            self.wheel(bool(msg.get("open")))
        elif kind == "dot":
            # Dragged (each move), or placed from the settings.
            self.dot = (max(0, int(msg.get("left", 8))), max(0, int(msg.get("bottom", 8))))
            if not self.wheel_open:
                self.place_dot()
        elif kind == "rail":
            if "autoHide" in msg:
                self.rail_mode(bool(msg.get("autoHide")))
        elif kind == "stage":
            if "enabled" in msg:
                self.stage_mode(bool(msg.get("enabled")))
            if msg.get("visible") is False:
                self.stage_hide(now=True)
            if msg.get("arriving"):
                self.stage_arriving()
            if msg.get("arrived"):
                self.stage_arrived()
        elif kind == "menu":
            self.menu(panel, msg)
        elif kind == "panel" and msg.get("name") in BESIDE_RAIL:
            # One panel beside the rail at a time: the other one closes.
            name = msg["name"]
            for other in BESIDE_RAIL:
                if other != name:
                    self.panels[other].js("window.scorpionPanel && window.scorpionPanel.close()")
            self.panels[name].js(f"window.scorpionPanel && window.scorpionPanel.toggle({json.dumps(msg.get('section'))})")
        elif kind == "size":
            p = self.panels.get(msg.get("panel"))
            if not p:
                return
            width = BESIDE_RAIL.get(msg.get("panel"))
            if width:
                h = max(1, min(int(msg.get("height") or 1), self.get_screen_height() - 16))
                p.set_size_request(width, h)
                p.resize(width, h)
                GtkLayerShell.set_keyboard_mode(p, GtkLayerShell.KeyboardMode.ON_DEMAND if msg.get("visible") else GtkLayerShell.KeyboardMode.NONE)
            if msg.get("visible"):
                p.show_all()
            else:
                p.hide()
        elif kind == "notifyAction":
            self.notifications.action(int(msg.get("id", 0)), str(msg.get("key", "default")))
        elif kind == "notifyClose":
            self.notifications.closed(int(msg.get("id", 0)), 2)
        elif kind == "notifyCloseAll":
            for nid in list(self.notifications.open):
                self.notifications.closed(nid, 2)

    def get_screen_height(self):
        display = Gdk.Display.get_default()
        mon = display.get_primary_monitor() or display.get_monitor(0)
        return mon.get_geometry().height if mon else 1080


def main():
    if not GtkLayerShell.is_supported():
        log("this compositor has no layer-shell; Scorpion shows its own panels")
        return 1
    host = Host()
    GLib.idle_add(host.start)
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
