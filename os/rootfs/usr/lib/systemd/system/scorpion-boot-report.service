# For the automatic boot test only (the kernel option scorpion.test): the
# checks inside the system (boot-test-steps): Scorpion running in the session,
# started again after a crash, the lock coming back after one, and everything
# there after sleeping and waking. Does nothing on a normal boot.
[Unit]
Description=The boot test's checks inside the system
ConditionKernelCommandLine=scorpion.test
After=graphical.target

[Service]
Type=oneshot
ExecStart=/usr/lib/scorpion-os/boot-test-steps
TimeoutStartSec=15min

[Install]
WantedBy=graphical.target
