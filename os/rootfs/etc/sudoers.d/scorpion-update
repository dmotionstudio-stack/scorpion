# Scorpion OS: administrators (the sudo group) may check for and install
# system updates from Scorpion without a password. Only these commands.
%sudo ALL=(root) NOPASSWD: /usr/lib/scorpion-os/scorpion-update check, /usr/lib/scorpion-os/scorpion-update install, /usr/lib/scorpion-os/scorpion-update clock, /usr/lib/scorpion-os/scorpion-update auto get, /usr/lib/scorpion-os/scorpion-update auto off, /usr/lib/scorpion-os/scorpion-update auto security, /usr/lib/scorpion-os/scorpion-update auto all
